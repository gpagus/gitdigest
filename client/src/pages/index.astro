---
export const prerender = false;
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import Feed from '../components/Feed.astro';
import TopBar from '../components/TopBar.astro';
import SearchBox from '../components/SearchBox.astro';

let noiseCount = 0;

const API_URL = import.meta.env.API_URL ?? 'http://127.0.0.1:8000';

const search = Astro.url.searchParams.get('repo') || '';
const cached = Astro.url.searchParams.get('cached') === '1';
let owner = '';
let repoName = '';
let prs = [];
let errorMessage = null;
let latestDigests = [];
const formatDate = (value) => {
  if (!value) return '';
  return new Intl.DateTimeFormat('es-ES', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(new Date(value));
};

try {
  const res = await fetch(`${API_URL}/api/digests?limit=6`, {
    signal: AbortSignal.timeout(5000),
  });
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data?.data)) latestDigests = data.data;
  }
} catch {
  latestDigests = [];
}

if (search) {
  const value = search.trim();
  const isGithubHost = /^(?:https?:\/\/)?(?:www\.)?github\.com(?:\/|$)/i.test(value);
  const match = isGithubHost
    ? value.match(
        /^(?:https?:\/\/)?(?:www\.)?github\.com\/([\w.-]+)\/([\w.-]+?)(?:\.git)?(?:[\/?#].*)?$/i
      )
    : value.match(/^([\w.-]+)\/([\w.-]+?)(?:\.git)?(?:[\/?#].*)?$/i);
  const onlyDots = (s) => /^\.+$/.test(s);

  if (!match || onlyDots(match[1]) || onlyDots(match[2])) {
    errorMessage = "Formato inválido. Pega la URL de GitHub o usa el formato 'owner/repo'.";
  } else {
    [, owner, repoName] = match;
    try {
      const endpoint = cached ? '/api/digests/' : '/api/feed/';
      const res = await fetch(
        `${API_URL}${endpoint}${encodeURIComponent(owner)}/${encodeURIComponent(repoName)}`,
        { signal: AbortSignal.timeout(10000) }
      );

      if (res.status === 404) {
        errorMessage = cached
          ? "Ese digest no está disponible en caché."
          : "Repositorio no encontrado en GitHub.";
      } else if (res.status === 202) {
        errorMessage = cached
          ? "Ese digest no está disponible en caché."
          : "El repositorio se está procesando. Vuelve a intentarlo en unos segundos...";
      } else if (!res.ok) {
        errorMessage = `El servidor respondió con un error (${res.status}).`;
      } else {
        const data = await res.json();
        if (!Array.isArray(data?.data)) {
          errorMessage = "Respuesta inesperada del servidor.";
        } else {
          if (data.repo) {
            const canonicalParts = data.repo.split('/');
            if (canonicalParts.length === 2) {
              [owner, repoName] = canonicalParts;
            }
          }
          prs = data.data.filter((pr) => !pr.es_ruido);
          noiseCount = data.data.length - prs.length;
          if (prs.length === 0) {
            errorMessage = "No hay actualizaciones relevantes para este repositorio.";
          }
        }
      }
    } catch {
      errorMessage = "No se pudo conectar con el servidor. Inténtalo de nuevo en unos segundos.";
    }
  }
}

// Dos estados de página: landing (sin búsqueda) y resultados (con búsqueda).
const hasSearch = Boolean(search);
const okRepo = search && !errorMessage ? `${owner}/${repoName}` : undefined;
// Los digests recientes solo se muestran si no hay feed: landing, o como salida tras un error.
const showDigests = latestDigests.length > 0 && prs.length === 0;

const digestLine = (d) => {
  const cambios = d.cambios === 1 ? 'Un cambio' : `${d.cambios} cambios`;
  const alta =
    d.relevancia_alta > 0
      ? d.relevancia_alta === 1
        ? ', uno de relevancia alta'
        : `, ${d.relevancia_alta} de relevancia alta`
      : '';
  const fecha = d.ultimo_pr ? ` Último PR el ${formatDate(d.ultimo_pr)}.` : '';
  return `${cambios}${alta}.${fecha}`;
};
---

<script>
  const KEY = "gitdigest:recent";
  const MAX = 3;

  const box = document.getElementById("search-box");
  const form = box.querySelector("form");
  const input = form.querySelector("input[name=repo]");
  const tray = document.getElementById("recent-tray");
  const list = document.getElementById("recent-list");
  const clearBtn = document.getElementById("recent-clear");
  const helpDialog = document.getElementById("help-dialog");
  const helpOpen = document.getElementById("help-open");
  const feedbackDialog = document.getElementById("feedback-dialog");
  const feedbackOpen = document.getElementById("feedback-open");
  const feedbackForm = document.getElementById("feedback-form");
  const feedbackStatus = document.getElementById("feedback-status");

  const read = () => {
    try { return JSON.parse(localStorage.getItem(KEY)) || []; } catch { return []; }
  };
  const write = (items) => {
    try { localStorage.setItem(KEY, JSON.stringify(items)); } catch {}
  };

  const close = () => tray.classList.add("hidden");

  function render() {
    const items = read();
    list.replaceChildren(...items.map((repo) => {
      const li = document.createElement("li");
      li.className = "flex items-center hover:bg-rock/20";

      const a = document.createElement("a");
      a.href = `?repo=${encodeURIComponent(repo)}`;
      a.textContent = repo;
      a.className = "flex-1 truncate px-5 py-3 text-sm font-semibold text-waikawa";

      const x = document.createElement("button");
      x.type = "button";
      x.textContent = "×";
      x.setAttribute("aria-label", `Quitar ${repo}`);
      x.className = "cursor-pointer px-4 py-3 text-waikawa hover:text-crail-ink";
      x.addEventListener("click", () => {
        write(read().filter((r) => r !== repo));
        if (!render()) close();
      });

      li.append(a, x);
      return li;
    }));
    return items.length;
  }

  const open = () => {
    if (document.activeElement === input && render()) {
      tray.classList.remove("hidden");
    }
  };

  // Guardar solo si esta carga fue una búsqueda satisfactoria
  const ok = form.dataset.okRepo;
  if (ok) {
    write([ok, ...read().filter((r) => r.toLowerCase() !== ok.toLowerCase())].slice(0, MAX));
  }

  input.addEventListener("focus", open);
  box.addEventListener("focusout", (event) => {
    if (!box.contains(event.relatedTarget)) close();
  });
  clearBtn.addEventListener("click", () => { write([]); close(); });

  // Barra superior en la landing: aparece cuando el logo grande sale de pantalla
  const topbar = document.getElementById("topbar");
  const heroBrand = document.getElementById("hero-brand");
  if (topbar && heroBrand && "IntersectionObserver" in window) {
    new IntersectionObserver(
      ([entry]) => { topbar.dataset.visible = String(!entry.isIntersecting); },
      { rootMargin: "-64px 0px 0px 0px" }
    ).observe(heroBrand);
  }

  // "Buscar repo" en la barra (solo landing): lleva al buscador grande y lo enfoca
  const topbarSearch = document.getElementById("topbar-search");
  topbarSearch?.addEventListener("click", () => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    input.scrollIntoView({ block: "center", behavior: reduce ? "auto" : "smooth" });
    input.focus({ preventScroll: true });
  });

  const positionHelp = () => {
    if (!helpDialog.matches(":popover-open")) return;

    const buttonRect = helpOpen.getBoundingClientRect();
    const popoverWidth = helpDialog.offsetWidth;
    const gap = 12;
    const horizontalPadding = 16;
    const left = Math.min(
      Math.max(buttonRect.left + (buttonRect.width - popoverWidth) / 2, horizontalPadding),
      window.innerWidth - popoverWidth - horizontalPadding
    );
    const top = Math.max(helpDialog.offsetHeight + gap <= buttonRect.top
      ? buttonRect.top - helpDialog.offsetHeight - gap
      : horizontalPadding, horizontalPadding);

    helpDialog.style.left = `${left}px`;
    helpDialog.style.top = `${top}px`;
  };

  helpDialog.addEventListener("toggle", () => {
    helpOpen.setAttribute("aria-expanded", String(helpDialog.matches(":popover-open")));
    if (helpDialog.matches(":popover-open")) requestAnimationFrame(positionHelp);
  });
  window.addEventListener("resize", positionHelp);
  window.addEventListener("scroll", positionHelp, true);

  const positionFeedback = () => {
    if (!feedbackDialog.matches(":popover-open")) return;
    const buttonRect = feedbackOpen.getBoundingClientRect();
    const popoverWidth = feedbackDialog.offsetWidth;
    const gap = 12;
    const padding = 16;
    const left = Math.min(
      Math.max(buttonRect.left + (buttonRect.width - popoverWidth) / 2, padding),
      window.innerWidth - popoverWidth - padding
    );
    const top = buttonRect.top >= feedbackDialog.offsetHeight + gap
      ? buttonRect.top - feedbackDialog.offsetHeight - gap
      : padding;
    feedbackDialog.style.left = `${left}px`;
    feedbackDialog.style.top = `${top}px`;
  };

  feedbackDialog.addEventListener("toggle", () => {
    feedbackOpen.setAttribute("aria-expanded", String(feedbackDialog.matches(":popover-open")));
    if (feedbackDialog.matches(":popover-open")) requestAnimationFrame(positionFeedback);
  });
  window.addEventListener("resize", positionFeedback);
  window.addEventListener("scroll", positionFeedback, true);

  feedbackForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submit = feedbackForm.querySelector("button[type=submit]");
    const formData = new FormData(feedbackForm);
    const apiUrl = feedbackDialog.dataset.apiUrl;
    submit.disabled = true;
    feedbackStatus.className = "text-sm text-waikawa";
    feedbackStatus.textContent = "Enviando...";
    try {
      const response = await fetch(`${apiUrl}/api/feedback`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(formData)),
      });
      if (!response.ok) {
        const data = await response.json().catch(() => ({}));
        throw new Error(data.detail || "No se pudo enviar el feedback.");
      }
      feedbackStatus.className = "text-sm font-semibold text-waikawa";
      feedbackStatus.textContent = "Gracias. He recibido tu feedback.";
      feedbackForm.reset();
    } catch (error) {
      feedbackStatus.className = "text-sm font-semibold text-crail-ink";
      feedbackStatus.textContent = error.message;
    } finally {
      submit.disabled = false;
    }
  });
</script>

<Layout>
  <TopBar withSearch={hasSearch} value={search} okRepo={okRepo} />

  {/* Vista de resultados: pt-24 = barra fija (4rem) + 2rem de aire */}
  <main class={`mx-auto flex w-full max-w-3xl flex-1 flex-col px-6 pb-24 ${hasSearch ? 'pt-24' : 'pt-16'}`}>

    {!hasSearch ? (
      <section class="flex flex-col items-center text-center">
        <div id="hero-brand" class="flex flex-col items-center">
          <a href="/">
            <img src="/logo.webp" alt="GitDigest Logo" class="mb-3 w-40 animate-scale-in rounded-2xl" />
          </a>
          <h1 class="font-sans text-4xl font-black tracking-tight text-carbon">
            Git<span class="ml-2 linear-gradient font-hubot rounded-2xl p-1">Digest</span>
          </h1>
        </div>
        <p class="mt-6 text-base text-waikawa">
          Pega la URL de un repo de GitHub y te cuento qué cambió, en cristiano.
        </p>
        <div class="mt-10 flex w-full justify-center">
          <SearchBox value="" okRepo={okRepo} />
        </div>
      </section>
    ) : (
      <h1 class="sr-only">GitDigest</h1>
    )}

    {/* Errores: texto plano justo debajo de la barra, sin caja */}
    {errorMessage && (
      <p role="alert" class="mb-4 text-base leading-relaxed text-crail-ink">
        {errorMessage}
      </p>
    )}

    {showDigests && (
      <section class={hasSearch ? 'mt-8' : 'mt-20'} aria-labelledby="latest-digests-title">
        <h2 id="latest-digests-title" class="font-hubot text-2xl text-carbon">Últimos digests</h2>
        <ul class="mt-5 divide-y divide-rock/60 border-y border-rock/60">
          {latestDigests.map((digest) => (
            <li>
              <a
                href={`?repo=${encodeURIComponent(digest.repo)}&cached=1`}
                class="group block py-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-jaffa sm:flex sm:items-baseline sm:justify-between sm:gap-6"
                aria-label={`Cargar el digest de ${digest.repo}`}
              >
                <span class="break-words font-hubot text-lg text-carbon underline decoration-transparent underline-offset-4 group-hover:decoration-jaffa">
                  {digest.repo}
                </span>
                <span class="mt-1 block text-sm text-waikawa sm:mt-0 sm:text-right">
                  {digestLine(digest)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Feed de Resultados */}
    {prs.length > 0 && (
      <Feed prs={prs} owner={owner} repo={repoName} noiseCount={noiseCount} />
    )}
  </main>
</Layout>
