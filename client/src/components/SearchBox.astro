---
// Dos variantes:
//  - hero (landing)
//  - compact (barra superior)
const { compact = false, value = '', okRepo } = Astro.props;
---

<div
  id="search-box"
  class={compact ? 'relative z-10 w-full max-w-xl flex-1 backdrop-blur-sm' : 'relative z-10 w-full max-w-xl animate-float'}
>
  <form class="search-frame relative flex w-full items-center" method="get" data-ok-repo={okRepo}>
    {compact ? (
      <svg
        class="pointer-events-none absolute left-3 h-4 w-4 text-waikawa"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
      </svg>
    ) : (
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 overflow-hidden rounded-l-2xl" aria-hidden="true">
        <svg class="absolute -top-1 left-3 h-20 w-20 text-waikawa/20" viewBox="0 0 16 16" fill="currentColor">
          <defs>
            <clipPath id="gh-cat">
              <path clip-rule="evenodd" d="M-1-1H17V17H-1Z M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </clipPath>
          </defs>
          <circle cx="8" cy="8" r="7.6" clip-path="url(#gh-cat)" />
        </svg>
      </div>
    )}

    <input
      type="text"
      name="repo"
      value={value}
      autocomplete="off"
      aria-label="Repositorio de GitHub"
      placeholder={compact ? 'owner/repo o URL de GitHub' : 'Ej: https://github.com/KytyPS5/KytyPS5'}
      class={compact
        ? 'w-full rounded-xl border border-rock bg-white py-2 pl-9 pr-11 text-base text-carbon placeholder-waikawa outline-none focus:ring-2 focus:ring-jaffa/40'
        : 'w-full py-4 pl-24 pr-16 text-lg bg-maize/30 border-0 rounded-2xl shadow-lg outline-none focus:ring-2 focus:ring-jaffa/40 transition-all text-waikawa placeholder-waikawa/30'}
    />

    <button
      type="submit"
      aria-label="Buscar"
      class={compact
        ? 'search-btn absolute right-1.5 top-1/2 -translate-y-1/2 cursor-pointer rounded-full p-2 text-white'
        : 'search-btn absolute right-3 top-1/2 -translate-y-1/2 p-3 text-white rounded-full hover:scale-105 cursor-pointer transition-all shadow-md'}
    >
      <svg class={compact ? 'h-4 w-4' : 'h-5 w-5'} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </button>
  </form>

  <!-- Bandeja de recientes -->
  <div
    id="recent-tray"
    class="hidden animate-fade-in absolute left-0 right-0 top-full z-20 mt-2 overflow-hidden rounded-2xl border border-rock bg-white/95 shadow-lg"
  >
    <div class="flex items-center justify-between px-5 pt-3 pb-1">
      <span class="text-sm text-waikawa">Recientes</span>
      <button
        id="recent-clear"
        type="button"
        class="cursor-pointer text-sm text-waikawa underline decoration-rock underline-offset-4 hover:decoration-jaffa"
      >
        Borrar todo
      </button>
    </div>
    <ul id="recent-list" class="pb-2"></ul>
  </div>
</div>
